//@version=5
indicator("RSI Recovery Scanner — Phase 3 Template (up to 35 symbols)", overlay=false, max_bars_back=500)

// ─────────────────────────────────────────────────────────────────────────────
//  TEMPLATE — Copy this file and replace input defaults with your symbol list.
//  Leave unused slots as empty strings "".
//  Each non-empty slot costs one request.security() call.
//  TradingView allows up to 40 per script (free plan); stay at ≤35 for headroom.
// ─────────────────────────────────────────────────────────────────────────────

