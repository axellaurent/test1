// ─── Helper: fmt_vol ─────────────────────────────────────────────────────────

fmt_vol(float v) =>
    if v >= 1e9
        str.tostring(v / 1e9, "#.##") + "B"
    else if v >= 1e6
        str.tostring(v / 1e6, "#.##") + "M"
    else
        str.tostring(v, "#,###")

// ─── Helper: state_transition ────────────────────────────────────────────────

state_transition(int st, float rsi, float vol, string sym) =>
    int ns = st
    if sym != "" and not na(rsi)
        if st == 0
            if rsi <= 30
                ns := 1
        else if st == 1
            ns := rsi > 30 ? 2 : 1
        else if st == 2
            if rsi > 30
                msg = "RSI Recovery | " + sym +
                      " | 12H | RSI: " + str.tostring(rsi, "#.##") +
                      " | Vol(12H): $" + fmt_vol(vol) +
                      " | SIGNAL: Confirmed Recovery" +
                      " | Bar: " + str.format_time(time, "yyyy-MM-dd HH:mm", "UTC") + " UTC"
                alert(msg, alert.freq_once_per_bar_close)
                ns := 3
            else
                ns := 1
        else if st == 3
            if rsi <= 30
                ns := 1
    ns

// ─── 12H RSI + Volume Fetches ─────────────────────────────────────────────────
// All request.security() calls must be unconditional (not inside if/for blocks).
// Empty-string slots return na and are ignored by state_transition.

[r01,v01] = request.security(i01!=""?i01:"BINANCE:BTCUSDT","720",[ta.rsi(close,14),volume*close],lookahead=barmerge.lookahead_off,gaps=barmerge.gaps_off)
[r02,v02] = request.security(i02!=""?i02:"BINANCE:BTCUSDT","720",[ta.rsi(close,14),volume*close],lookahead=barmerge.lookahead_off,gaps=barmerge.gaps_off)
