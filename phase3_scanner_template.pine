// ─── Status Table ────────────────────────────────────────────────────────────

state_clr(int st) =>
    st==1?color.red : st==2?color.orange : st==3?color.green : color.gray

state_lbl(int st) =>
    st==0?"Wait" : st==1?"Ovrsld" : st==2?"Recov" : "Confmd"

var table tbl = table.new(position.top_right, 3, 36,
     bgcolor=color.rgb(20,20,20), border_color=color.gray, border_width=1)

syms_arr = array.from(i01,i02,i03,i04,i05,i06,i07,i08,i09,i10,
                      i11,i12,i13,i14,i15,i16,i17,i18,i19,i20,
                      i21,i22,i23,i24,i25,i26,i27,i28,i29,i30,
                      i31,i32,i33,i34,i35)
sts_arr  = array.from(s01,s02,s03,s04,s05,s06,s07,s08,s09,s10,
                      s11,s12,s13,s14,s15,s16,s17,s18,s19,s20,
                      s21,s22,s23,s24,s25,s26,s27,s28,s29,s30,
                      s31,s32,s33,s34,s35)
rsis_arr = array.from(r01,r02,r03,r04,r05,r06,r07,r08,r09,r10,
                      r11,r12,r13,r14,r15,r16,r17,r18,r19,r20,
                      r21,r22,r23,r24,r25,r26,r27,r28,r29,r30,
                      r31,r32,r33,r34,r35)

if barstate.islast
    table.cell(tbl,0,0,"Symbol",  text_color=color.gray, text_size=size.small, bgcolor=color.rgb(40,40,40))
    table.cell(tbl,1,0,"State",   text_color=color.gray, text_size=size.small, bgcolor=color.rgb(40,40,40))
    table.cell(tbl,2,0,"RSI 12H", text_color=color.gray, text_size=size.small, bgcolor=color.rgb(40,40,40))
    for i = 0 to 34
        sym = array.get(syms_arr, i)
        st  = array.get(sts_arr,  i)
        rsi = array.get(rsis_arr, i)
        row = i + 1
        if sym != ""
            table.cell(tbl,0,row, sym,            text_color=color.white,       text_size=size.tiny)
            table.cell(tbl,1,row, state_lbl(st),  text_color=state_clr(st),     text_size=size.tiny)
            table.cell(tbl,2,row, not na(rsi) ? str.tostring(rsi,"#.#") : "n/a",
                 text_color=color.white, text_size=size.tiny)
