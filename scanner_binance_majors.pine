//@version=5
indicator("RSI Recovery Scanner — Binance Majors (20 USDT pairs)", overlay=false, max_bars_back=500)

// 20 high-volume Binance USDT pairs  (all well above $1M USD daily volume)
// Request count: 20  |  Free plan limit: 40  |  Headroom: 20

// ─── Helpers ─────────────────────────────────────────────────────────────────

fmt_vol(float v) =>
    if v >= 1e9
        str.tostring(v / 1e9, "#.##") + "B"
    else if v >= 1e6
        str.tostring(v / 1e6, "#.##") + "M"
    else
        str.tostring(v, "#,###")

state_transition(int st, float rsi, float vol, string sym) =>
    int ns = st
    if not na(rsi)
        if st == 0
            if rsi <= 30
                ns := 1
        else if st == 1
            ns := rsi > 30 ? 2 : 1
        else if st == 2
            if rsi > 30
                msg = "RSI Recovery | " + sym +
                      " | 12H | RSI: " + str.tostring(rsi, "#.##") +
                      " | Vol(12H): $" + fmt_vol(vol) +
                      " | SIGNAL: Confirmed Recovery" +
                      " | Bar: " + str.format_time(time, "yyyy-MM-dd HH:mm", "UTC") + " UTC"
                alert(msg, alert.freq_once_per_bar_close)
                ns := 3
            else
                ns := 1
        else if st == 3
            if rsi <= 30
                ns := 1
    ns

// ─── 12H RSI + Volume ────────────────────────────────────────────────────────

[r01,v01] = request.security("BINANCE:BTCUSDT",   "720",[ta.rsi(close,14),volume*close],lookahead=barmerge.lookahead_off,gaps=barmerge.gaps_off,ignore_invalid_symbol=true)
[r02,v02] = request.security("BINANCE:ETHUSDT",   "720",[ta.rsi(close,14),volume*close],lookahead=barmerge.lookahead_off,gaps=barmerge.gaps_off,ignore_invalid_symbol=true)
[r03,v03] = request.security("BINANCE:BNBUSDT",   "720",[ta.rsi(close,14),volume*close],lookahead=barmerge.lookahead_off,gaps=barmerge.gaps_off,ignore_invalid_symbol=true)
[r04,v04] = request.security("BINANCE:SOLUSDT",   "720",[ta.rsi(close,14),volume*close],lookahead=barmerge.lookahead_off,gaps=barmerge.gaps_off,ignore_invalid_symbol=true)
[r05,v05] = request.security("BINANCE:XRPUSDT",   "720",[ta.rsi(close,14),volume*close],lookahead=barmerge.lookahead_off,gaps=barmerge.gaps_off,ignore_invalid_symbol=true)
[r06,v06] = request.security("BINANCE:ADAUSDT",   "720",[ta.rsi(close,14),volume*close],lookahead=barmerge.lookahead_off,gaps=barmerge.gaps_off,ignore_invalid_symbol=true)
[r07,v07] = request.security("BINANCE:DOGEUSDT",  "720",[ta.rsi(close,14),volume*close],lookahead=barmerge.lookahead_off,gaps=barmerge.gaps_off,ignore_invalid_symbol=true)
[r08,v08] = request.security("BINANCE:AVAXUSDT",  "720",[ta.rsi(close,14),volume*close],lookahead=barmerge.lookahead_off,gaps=barmerge.gaps_off,ignore_invalid_symbol=true)
[r09,v09] = request.security("BINANCE:TRXUSDT",   "720",[ta.rsi(close,14),volume*close],lookahead=barmerge.lookahead_off,gaps=barmerge.gaps_off,ignore_invalid_symbol=true)
[r10,v10] = request.security("BINANCE:DOTUSDT",   "720",[ta.rsi(close,14),volume*close],lookahead=barmerge.lookahead_off,gaps=barmerge.gaps_off,ignore_invalid_symbol=true)
[r11,v11] = request.security("BINANCE:POLUSDT", "720",[ta.rsi(close,14),volume*close],lookahead=barmerge.lookahead_off,gaps=barmerge.gaps_off,ignore_invalid_symbol=true)
[r12,v12] = request.security("BINANCE:LTCUSDT",   "720",[ta.rsi(close,14),volume*close],lookahead=barmerge.lookahead_off,gaps=barmerge.gaps_off,ignore_invalid_symbol=true)
[r13,v13] = request.security("BINANCE:BCHUSDT",   "720",[ta.rsi(close,14),volume*close],lookahead=barmerge.lookahead_off,gaps=barmerge.gaps_off,ignore_invalid_symbol=true)
[r14,v14] = request.security("BINANCE:UNIUSDT",   "720",[ta.rsi(close,14),volume*close],lookahead=barmerge.lookahead_off,gaps=barmerge.gaps_off,ignore_invalid_symbol=true)
[r15,v15] = request.security("BINANCE:ATOMUSDT",  "720",[ta.rsi(close,14),volume*close],lookahead=barmerge.lookahead_off,gaps=barmerge.gaps_off,ignore_invalid_symbol=true)
[r16,v16] = request.security("BINANCE:ETCUSDT",   "720",[ta.rsi(close,14),volume*close],lookahead=barmerge.lookahead_off,gaps=barmerge.gaps_off,ignore_invalid_symbol=true)
[r17,v17] = request.security("BINANCE:XLMUSDT",   "720",[ta.rsi(close,14),volume*close],lookahead=barmerge.lookahead_off,gaps=barmerge.gaps_off,ignore_invalid_symbol=true)
[r18,v18] = request.security("BINANCE:NEARUSDT",  "720",[ta.rsi(close,14),volume*close],lookahead=barmerge.lookahead_off,gaps=barmerge.gaps_off,ignore_invalid_symbol=true)
[r19,v19] = request.security("BINANCE:FILUSDT",   "720",[ta.rsi(close,14),volume*close],lookahead=barmerge.lookahead_off,gaps=barmerge.gaps_off,ignore_invalid_symbol=true)
[r20,v20] = request.security("BINANCE:AAVEUSDT",  "720",[ta.rsi(close,14),volume*close],lookahead=barmerge.lookahead_off,gaps=barmerge.gaps_off,ignore_invalid_symbol=true)

// ─── State Variables ─────────────────────────────────────────────────────────

var int s01=0, var int s02=0, var int s03=0, var int s04=0, var int s05=0
var int s06=0, var int s07=0, var int s08=0, var int s09=0, var int s10=0
var int s11=0, var int s12=0, var int s13=0, var int s14=0, var int s15=0
var int s16=0, var int s17=0, var int s18=0, var int s19=0, var int s20=0

// ─── State Updates ───────────────────────────────────────────────────────────

new_12h_bar = ta.change(time("720")) != 0

if new_12h_bar
    s01:=state_transition(s01,r01,v01,"BINANCE:BTCUSDT")
    s02:=state_transition(s02,r02,v02,"BINANCE:ETHUSDT")
    s03:=state_transition(s03,r03,v03,"BINANCE:BNBUSDT")
    s04:=state_transition(s04,r04,v04,"BINANCE:SOLUSDT")
    s05:=state_transition(s05,r05,v05,"BINANCE:XRPUSDT")
    s06:=state_transition(s06,r06,v06,"BINANCE:ADAUSDT")
    s07:=state_transition(s07,r07,v07,"BINANCE:DOGEUSDT")
    s08:=state_transition(s08,r08,v08,"BINANCE:AVAXUSDT")
    s09:=state_transition(s09,r09,v09,"BINANCE:TRXUSDT")
    s10:=state_transition(s10,r10,v10,"BINANCE:DOTUSDT")
    s11:=state_transition(s11,r11,v11,"BINANCE:POLUSDT")
    s12:=state_transition(s12,r12,v12,"BINANCE:LTCUSDT")
    s13:=state_transition(s13,r13,v13,"BINANCE:BCHUSDT")
    s14:=state_transition(s14,r14,v14,"BINANCE:UNIUSDT")
    s15:=state_transition(s15,r15,v15,"BINANCE:ATOMUSDT")
    s16:=state_transition(s16,r16,v16,"BINANCE:ETCUSDT")
    s17:=state_transition(s17,r17,v17,"BINANCE:XLMUSDT")
    s18:=state_transition(s18,r18,v18,"BINANCE:NEARUSDT")
    s19:=state_transition(s19,r19,v19,"BINANCE:FILUSDT")
    s20:=state_transition(s20,r20,v20,"BINANCE:AAVEUSDT")

// ─── Status Table ────────────────────────────────────────────────────────────

state_clr(int st) =>
    st==1?color.red : st==2?color.orange : st==3?color.green : color.gray

state_lbl(int st) =>
    st==0?"Wait" : st==1?"Ovrsld" : st==2?"Recov" : "Confmd"

var table tbl = table.new(position.top_right, 3, 21,
     bgcolor=color.rgb(20,20,20), border_color=color.gray, border_width=1)

if barstate.islast
    table.cell(tbl,0,0,"Symbol (Binance)",text_color=color.gray,text_size=size.small,bgcolor=color.rgb(40,40,40))
    table.cell(tbl,1,0,"State",           text_color=color.gray,text_size=size.small,bgcolor=color.rgb(40,40,40))
    table.cell(tbl,2,0,"RSI 12H",         text_color=color.gray,text_size=size.small,bgcolor=color.rgb(40,40,40))

    tickers = array.from("BTCUSDT","ETHUSDT","BNBUSDT","SOLUSDT","XRPUSDT",
                         "ADAUSDT","DOGEUSDT","AVAXUSDT","TRXUSDT","DOTUSDT",
                         "POLUSDT","LTCUSDT","BCHUSDT","UNIUSDT","ATOMUSDT",
                         "ETCUSDT","XLMUSDT","NEARUSDT","FILUSDT","AAVEUSDT")
    sts   = array.from(s01,s02,s03,s04,s05,s06,s07,s08,s09,s10,
                       s11,s12,s13,s14,s15,s16,s17,s18,s19,s20)
    rsis  = array.from(r01,r02,r03,r04,r05,r06,r07,r08,r09,r10,
                       r11,r12,r13,r14,r15,r16,r17,r18,r19,r20)

    for i = 0 to 19
        st  = array.get(sts,  i)
        rsi = array.get(rsis, i)
        table.cell(tbl,0,i+1,array.get(tickers,i), text_color=color.white,   text_size=size.tiny)
        table.cell(tbl,1,i+1,na(rsi)?"INVALID":state_lbl(st), text_color=na(rsi)?color.fuchsia:state_clr(st), text_size=size.tiny)
        table.cell(tbl,2,i+1,not na(rsi)?str.tostring(rsi,"#.#"):"n/a",
             text_color=color.white, text_size=size.tiny)
