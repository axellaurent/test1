//@version=5
indicator("RSI Recovery Scanner — Phase 1 (Single Symbol)", overlay=false, max_bars_back=500)

// ─── State Machine ────────────────────────────────────────────────────────────
//  State 0  Waiting for RSI to close below 30
//  State 1  RSI has closed below 30 (oversold triggered)
//  State 2  First 12H candle closed back above 30
//  State 3  Alert fired; waiting for RSI to close below 30 again to reset
//
//  Transitions
//   0 → 1   RSI ≤ 30
//   1 → 2   RSI > 30
//   1 stays  RSI ≤ 30
//   2 → 3   RSI > 30 (fires alert)
//   2 → 1   RSI ≤ 30
//   3 → 1   RSI ≤ 30 (reset; oversold immediately satisfied)
//   3 stays  RSI > 30
// ─────────────────────────────────────────────────────────────────────────────

// ─── Helper: fmt_vol ─────────────────────────────────────────────────────────

fmt_vol(float v) =>
    if v >= 1e9
        str.tostring(v / 1e9, "#.##") + "B"
    else if v >= 1e6
        str.tostring(v / 1e6, "#.##") + "M"
    else
        str.tostring(v, "#,###")

// ─── 12H Data ────────────────────────────────────────────────────────────────

[rsi_12h, vol_12h] = request.security(
     syminfo.tickerid, "720",
     [ta.rsi(close, 14), volume * close],
     lookahead = barmerge.lookahead_off,
     gaps      = barmerge.gaps_off)

// True on the first chart bar after each 12H bar closes
new_12h_bar = ta.change(time("720")) != 0

// ─── State ───────────────────────────────────────────────────────────────────

var int state = 0

// ─── State Transitions ───────────────────────────────────────────────────────

if new_12h_bar and not na(rsi_12h)
    if state == 0
        if rsi_12h <= 30
            state := 1

    else if state == 1
        state := rsi_12h > 30 ? 2 : 1

    else if state == 2
        if rsi_12h > 30
            vol_str = fmt_vol(vol_12h)
            msg = "RSI Recovery | " + syminfo.tickerid +
                  " | 12H | RSI: "  + str.tostring(rsi_12h, "#.##") +
                  " | Vol(12H): $"  + vol_str +
                  " | SIGNAL: Confirmed Recovery" +
                  " | Bar: " + str.format_time(time, "yyyy-MM-dd HH:mm", "UTC") + " UTC"
            alert(msg, alert.freq_once_per_bar_close)
            state := 3
        else
            state := 1

    else if state == 3
        if rsi_12h <= 30
            state := 1

// ─── Visuals ──────────────────────────────────────────────────────────────────

plot(rsi_12h, "RSI 12H", color=color.white, linewidth=2)
hline(30, "Oversold",   color=color.red,   linestyle=hline.style_dashed)
hline(70, "Overbought", color=color.green, linestyle=hline.style_dashed)
hline(50, "Midline",    color=color.gray,  linestyle=hline.style_dotted)

bg = state == 1 ? color.new(color.red,85) : state == 2 ? color.new(color.yellow,85) : state == 3 ? color.new(color.green,85) : color.new(color.gray,92)
bgcolor(bg, title="State Background")

// Label on the last bar showing current state and RSI
var label status_lbl = na
label.delete(status_lbl)
state_names = array.from("0 — Waiting", "1 — Oversold", "2 — Recovering", "3 — Confirmed")
if barstate.islast and not na(rsi_12h)
    status_lbl := label.new(
         bar_index, rsi_12h,
         "State: " + array.get(state_names, state) + "\nRSI(12H): " + str.tostring(rsi_12h, "#.##"),
         style     = label.style_label_left,
         color     = color.blue,
         textcolor = color.white,
         size      = size.normal)
