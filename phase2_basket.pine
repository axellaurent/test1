//@version=5
indicator("RSI Recovery Scanner — Phase 2 (5-Symbol Basket)", overlay=false, max_bars_back=500)

// ─── Symbols ──────────────────────────────────────────────────────────────────
// Edit these five strings to test different symbols.
// Must be complete TradingView identifiers (EXCHANGE:TICKER).

string SYM1 = "BINANCE:BTCUSDT"
string SYM2 = "BINANCE:ETHUSDT"
string SYM3 = "BINANCE:SOLUSDT"
string SYM4 = "NASDAQ:AAPL"
string SYM5 = "NYSE:SPY"

// ─── Helper: fmt_vol ─────────────────────────────────────────────────────────

fmt_vol(float v) =>
    v >= 1e9 ? str.tostring(v / 1e9, "#.##") + "B" :
    v >= 1e6 ? str.tostring(v / 1e6, "#.##") + "M" :
               str.tostring(v, "#,###")

// ─── Helper: state_transition ────────────────────────────────────────────────
// Returns the new state.  Fires alert() as a side effect when State 2→3.

state_transition(int st, float rsi, float vol, string sym) =>
    int ns = st
    if not na(rsi)
        if st == 0
            if rsi <= 30
                ns := 1
        else if st == 1
            ns := rsi > 30 ? 2 : 1
        else if st == 2
            if rsi > 30
                msg = "RSI Recovery | " + sym +
                      " | 12H | RSI: " + str.tostring(rsi, "#.##") +
                      " | Vol(12H): $" + fmt_vol(vol) +
                      " | SIGNAL: Confirmed Recovery" +
                      " | Bar: " + str.format_time(time, "yyyy-MM-dd HH:mm", "UTC") + " UTC"
                alert(msg, alert.freq_once_per_bar_close)
                ns := 3
            else
                ns := 1
        else if st == 3
            if rsi <= 30
                ns := 1
    ns

// ─── 12H RSI + Volume per Symbol ─────────────────────────────────────────────

[r1, v1] = request.security(SYM1, "720", [ta.rsi(close, 14), volume * close], lookahead=barmerge.lookahead_off, gaps=barmerge.gaps_off)
[r2, v2] = request.security(SYM2, "720", [ta.rsi(close, 14), volume * close], lookahead=barmerge.lookahead_off, gaps=barmerge.gaps_off)
[r3, v3] = request.security(SYM3, "720", [ta.rsi(close, 14), volume * close], lookahead=barmerge.lookahead_off, gaps=barmerge.gaps_off)
[r4, v4] = request.security(SYM4, "720", [ta.rsi(close, 14), volume * close], lookahead=barmerge.lookahead_off, gaps=barmerge.gaps_off)
[r5, v5] = request.security(SYM5, "720", [ta.rsi(close, 14), volume * close], lookahead=barmerge.lookahead_off, gaps=barmerge.gaps_off)

// ─── Per-Symbol State (persistent across bars) ───────────────────────────────

var int s1 = 0
var int s2 = 0
var int s3 = 0
var int s4 = 0
var int s5 = 0

// ─── State Updates (gated on 12H bar close) ──────────────────────────────────

new_12h_bar = ta.change(time("720")) != 0

if new_12h_bar
    s1 := state_transition(s1, r1, v1, SYM1)
    s2 := state_transition(s2, r2, v2, SYM2)
    s3 := state_transition(s3, r3, v3, SYM3)
    s4 := state_transition(s4, r4, v4, SYM4)
    s5 := state_transition(s5, r5, v5, SYM5)

// ─── Status Table ────────────────────────────────────────────────────────────

state_color(int st) =>
    st == 1 ? color.red    :
    st == 2 ? color.orange :
    st == 3 ? color.green  :
              color.gray

state_label(int st) =>
    st == 0 ? "Waiting"    :
    st == 1 ? "Oversold"   :
    st == 2 ? "Recovering" :
              "Confirmed"

var table tbl = table.new(position.top_right, 3, 6,
     bgcolor      = color.rgb(20, 20, 20),
     border_color = color.gray,
     border_width  = 1)

if barstate.islast
    // Header
    table.cell(tbl, 0, 0, "Symbol",   text_color=color.gray,  text_size=size.small, bgcolor=color.rgb(40,40,40))
    table.cell(tbl, 1, 0, "State",    text_color=color.gray,  text_size=size.small, bgcolor=color.rgb(40,40,40))
    table.cell(tbl, 2, 0, "RSI 12H",  text_color=color.gray,  text_size=size.small, bgcolor=color.rgb(40,40,40))

    syms = array.from(SYM1, SYM2, SYM3, SYM4, SYM5)
    sts  = array.from(s1, s2, s3, s4, s5)
    rsis = array.from(r1, r2, r3, r4, r5)

    for i = 0 to 4
        sym = array.get(syms, i)
        st  = array.get(sts,  i)
        rsi = array.get(rsis, i)
        clr = state_color(st)
        lbl = state_label(st)
        row = i + 1
        table.cell(tbl, 0, row, sym, text_color=color.white, text_size=size.small)
        table.cell(tbl, 1, row, lbl, text_color=clr,         text_size=size.small)
        table.cell(tbl, 2, row, not na(rsi) ? str.tostring(rsi, "#.#") : "n/a",
             text_color = color.white, text_size = size.small)
